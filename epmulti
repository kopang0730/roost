ROBLOX_VERSION_URL = "https://clientsettingscdn.roblox.com/v2/client-version/MacPlayer/channel/LIVE"


def _get_json(url, timeout=10):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def roblox_versions():
    """本机版本 vs 官方最新版本。"""
    installed_short = None
    r = run(["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString",
             os.path.join(ROBLOX_APP, "Contents", "Info.plist")])
    if r.returncode == 0:
        installed_short = r.stdout.strip()
    latest = None
    err = None
    try:
        latest = _get_json(ROBLOX_VERSION_URL).get("version")
    except Exception as e:
        err = str(e)[:120]
    build = None
    if latest:
        parts = latest.split(".")
        build = ".".join(parts[-2:]) if len(parts) >= 2 else latest
    installed_build = ".".join(installed_short.split(".")[-2:]) if installed_short else None
    return {"installed": installed_short, "installed_build": installed_build,
            "latest": latest, "latest_build": build,
            "update_available": bool(latest and installed_short and latest != installed_short),
            "error": err}


def account_pids(name):
    app = instance_app(name)
    pat = re.escape(os.path.join(app, "Contents", "MacOS", "RobloxPlayer"))
    r = run(["pgrep", "-f", pat])
    if r.returncode != 0:
        return []
    return [int(x) for x in r.stdout.split() if x.strip().isdigit()]


def kill_pids(pids, wait=2.0):
    for pid in pids:
        try:
            os.kill(pid, 15)
        except Exception:
            pass
    end = time.time() + wait
    while time.time() < end:
        if not any(_alive(pid) for pid in pids):
            return True
        time.sleep(0.15)
    for pid in pids:
        try:
            os.kill(pid, 9)
        except Exception:
            pass
    return True


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except Exception:
        return False

