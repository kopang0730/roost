# ------------------------------------------------------------------ CFNetwork cookie 写入器

def ensure_helper():
    """构建一个极小的 CookieJar.app —— 靠 CFNetwork 自己把 cookie 写进目标库。

    比起手写 binarycookies 的二进制格式，这条路零格式风险：写出来的文件
    就是 CFNetwork 自己的东西。bundle id 在注入时改成目标副本的 id，
    这样它写的就是 ~/Library/HTTPStorages/<bid>.binarycookies。
    """
    app = os.path.join(BIN, "CookieJar.app")
    binary = os.path.join(app, "Contents", "MacOS", "CookieJar")
    if os.path.exists(binary):
        return app
    # app 里带了预编译好的 helper（朋友机器没装 clang 也能用）
    here = os.path.dirname(os.path.abspath(__file__))
    bundled = os.path.join(here, "helper", "CookieJar.app")
    if os.path.isdir(bundled):
        os.makedirs(BIN, exist_ok=True)
        shutil.copytree(bundled, app)
        run(["xattr", "-cr", app])
        return app
    os.makedirs(os.path.join(app, "Contents", "MacOS"), exist_ok=True)
    open(JAR_SRC, "w").write(JAR_SOURCE)
    info = {
        "CFBundleIdentifier": "com.epmulti.cookiejar",
        "CFBundleName": "CookieJar",
        "CFBundleExecutable": "CookieJar",
        "CFBundlePackageType": "APPL",
        "CFBundleVersion": "1",
        "CFBundleShortVersionString": "1.0",
    }
    with open(os.path.join(app, "Contents", "Info.plist"), "wb") as f:
        plistlib.dump(info, f)
    r = run(["clang", "-fobjc-arc", "-framework", "Foundation", "-o", binary, JAR_SRC])
    if r.returncode != 0:
        raise RuntimeError(T("clang 编译失败: ", "clang build failed: ") + (r.stderr or "").strip()[:200])
    run(["codesign", "--force", "-s", "-", app])
    return app


def inject_cookie(name, cookie):
    """把会话写进该账号副本专属的 cookie 库（bundle id = 副本 id）。"""
    try:
        src = ensure_helper()
    except Exception as e:
        return False, str(e)
    bid = bundle_id_for(name)
    work = os.path.join(BIN, "jar-" + slug(name) + ".app")
    if os.path.exists(work):
        shutil.rmtree(work)
    shutil.copytree(src, work)
    plist = os.path.join(work, "Contents", "Info.plist")
    info = plistlib.load(open(plist, "rb"))
    info["CFBundleIdentifier"] = bid
    with open(plist, "wb") as f:
        plistlib.dump(info, f)
    run(["xattr", "-cr", work])
    r = run(["codesign", "--force", "-s", "-", work])
    if r.returncode != 0:
        return False, T("helper 重签失败: ", "helper re-sign failed: ") + (r.stderr or "").strip()[:160]
    r = run([os.path.join(work, "Contents", "MacOS", "CookieJar"), cookie])
    if r.returncode != 0:
        return False, (r.stderr or r.stdout or "helper 运行失败").strip()[:160]
    dst = os.path.expanduser("~/Library/HTTPStorages/" + bid + ".binarycookies")
    if not os.path.exists(dst):
        return False, T("CFNetwork 未落盘: ", "CFNetwork did not write: ") + dst
    os.chmod(dst, 0o600)
    return True, dst


def read_back_cookie(name):
    """用同一个 helper 读回，确认注入的会话确实在库里（返回 value 长度）。"""
    work = os.path.join(BIN, "jar-" + slug(name) + ".app")
    exe = os.path.join(work, "Contents", "MacOS", "CookieJar")
    if not os.path.exists(exe):
        return None
    r = run([exe, "--read"])
    for line in (r.stdout or "").splitlines():
        parts = line.split("\t")
        if len(parts) == 4 and parts[1] == ".ROBLOSECURITY" and parts[0] == ".roblox.com":
            return int(parts[3])
    return None


# ------------------------------------------------------------------ HTTP

def _req(url, cookie, method="GET", data=None, extra=None):
    headers = {
        "Cookie": ".ROBLOSECURITY=" + cookie,
        "User-Agent": UA,
        "Referer": "https://www.roblox.com/",
        "Origin": "https://www.roblox.com",
        "Accept": "application/json",
    }
    if data is not None:
        headers["Content-Type"] = "application/json"
    if extra:
        headers.update(extra)
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, dict(r.headers), r.read()
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), e.read()


def whoami(cookie):
    st, _, body = _req(WHOAMI_URL, cookie)
    if st != 200:
        return None, "HTTP %d" % st
    try:
        j = json.loads(body)
    except Exception:
        return None, T("响应不是 JSON", "response is not JSON")
    return {"user_id": j.get("id"), "username": j.get("name"),
            "display_name": j.get("displayName")}, None


def mint_ticket(cookie):
    st, hdr, _ = _req(TICKET_URL, cookie, method="POST", data=b"{}")
    if st == 403:
        csrf = hdr.get("x-csrf-token") or hdr.get("X-CSRF-Token")
        if not csrf:
            return None, T("403 且没有 x-csrf-token", "403 without x-csrf-token")
        st, hdr, _ = _req(TICKET_URL, cookie, method="POST", data=b"{}",
                          extra={"X-CSRF-TOKEN": csrf})
    if st != 200:
        return None, "HTTP %d" % st
    ticket = hdr.get("rbx-authentication-ticket") or hdr.get("Rbx-Authentication-Ticket")
    return (ticket, None) if ticket else (None, T("200 但没有 rbx-authentication-ticket", "200 without rbx-authentication-ticket"))


# ------------------------------------------------------------------ 副本

def src_version():
    r = run(["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion",
             os.path.join(ROBLOX_APP, "Contents", "Info.plist")])
    return r.stdout.strip() if r.returncode == 0 else "?"


def instance_dir(name):
    return os.path.join(INSTANCES, slug(name))


def instance_app(name):
    return os.path.join(instance_dir(name), "Roblox.app")


def instance_ready(name):
    marker = os.path.join(instance_dir(name), ".epmulti-ready")
    if not (os.path.isdir(instance_app(name)) and os.path.exists(marker)):
        return False
    try:
        return json.load(open(marker)).get("src_version") == src_version()
    except Exception:
        return False


def write_flags(app, flags, fps=None):
    """把 FFlags 写进副本的 Contents/Resources/ClientSettings/ClientAppSettings.json。"""
    data = dict(flags or {})
    if fps:
        data["DFIntTaskSchedulerTargetFps"] = str(int(fps))
    if not data:
        return None
    d = os.path.join(app, "Contents", "Resources", "ClientSettings")
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, "ClientAppSettings.json")
    with open(p, "w") as f:
        json.dump(data, f, indent=2, sort_keys=True)
    return p


def ensure_instance(name, flags=None, fps=None, quiet=False):
    """准备独立副本：clonefile → 改 bundle id → 解除单实例 → 写 FFlags → ad-hoc 重签。"""
    if instance_ready(name):
        app = instance_app(name)
        if write_flags(app, flags, fps):
            run(["codesign", "--force", "--deep", "-s", "-", app])
        return app
    if not os.path.isdir(ROBLOX_APP):
        die(T("找不到 ", "Cannot find ") + ROBLOX_APP)
    d, app = instance_dir(name), instance_app(name)
    if os.path.exists(d):
        shutil.rmtree(d)
    os.makedirs(d, exist_ok=True)
    if not quiet:
        say("  复制 Roblox.app（APFS clonefile）", C_DIM)
    r = run(["cp", "-cR", ROBLOX_APP, app])
    if r.returncode != 0:
        if not quiet:
            say("  clonefile 不可用，退回 ditto（286 MB）", C_YEL)
        r = run(["ditto", ROBLOX_APP, app])
        if r.returncode != 0:
            die(T("复制失败: ", "copy failed: ") + r.stderr.strip())

    plist = os.path.join(app, "Contents", "Info.plist")
    for k, v in ((":CFBundleIdentifier", bundle_id_for(name)),
                 (":LSMultipleInstancesProhibited", "false"),
                 (":CFBundleName", "Roblox (" + name + ")")):
        run(["/usr/libexec/PlistBuddy", "-c", "Set %s %s" % (k, v), plist])
    write_flags(app, flags, fps)
    run(["xattr", "-cr", app])
    if not quiet:
        say("  重签（ad-hoc）", C_DIM)
    r = run(["codesign", "--force", "--deep", "-s", "-", app])
    if r.returncode != 0:
        die(T("重签失败: ", "re-sign failed: ") + (r.stderr or "").strip())
    json.dump({"bundle_id": bundle_id_for(name), "src_version": src_version(),
               "created": int(time.time())},
              open(os.path.join(d, ".epmulti-ready"), "w"))
    return app


# ------------------------------------------------------------------ 启动

def build_url(ticket, place_id=None):
    bt = random.randint(10 ** 14, 10 ** 15 - 1)
    lt = int(time.time() * 1000)
    if place_id:
        plc = ("https://assetgame.roblox.com/game/PlaceLauncher.ashx?request=RequestGame"
               "&browserTrackerId=%d&placeId=%s&isPlayTogetherGame=false" % (bt, place_id))
        return ("roblox-player:1+launchmode:play+gameinfo:%s+launchtime:%d"
                "+placelauncherurl:%s+browsertrackerid:%d"
                "+robloxLocale:en_us+gameLocale:en_us" % (ticket, lt,
                                                          urllib.parse.quote(plc, safe=""), bt))
    return ("roblox-player:1+launchmode:app+gameinfo:%s+launchtime:%d"
            "+browsertrackerid:%d+robloxLocale:en_us+gameLocale:en_us" % (ticket, lt, bt))


def clone_pid(app, timeout=15.0):
    pat = re.escape(os.path.join(app, "Contents", "MacOS", "RobloxPlayer"))
    end = time.time() + timeout
    while time.time() < end:
        r = run(["pgrep", "-f", pat])
        if r.returncode == 0 and r.stdout.strip():
            return int(r.stdout.split()[0])
        time.sleep(0.4)
    return None


def screen_frame():
    """逻辑屏幕边界 (x0, y0, x1, y1)。走 Finder，不需要辅助功能权限。"""
    r = run(["osascript", "-e", 'tell application "Finder" to get bounds of window of desktop'])
    if r.returncode != 0:
        return None
    try:
        parts = [int(p.strip()) for p in r.stdout.strip().split(",")]
        if len(parts) == 4 and parts[2] > parts[0] and parts[3] > parts[1]:
            return tuple(parts)
    except Exception:
        pass
    return None


def grid_position(slot, total, w, h):
    """把第 slot 个（共 total 个）窗口摆成网格，尽量居中不重叠。"""
    f = screen_frame()
    if not f:
        return None
    x0, y0, x1, y1 = f
    sw, sh = x1 - x0, y1 - y0
    total = max(1, int(total))
    slot = max(0, min(int(slot), total - 1))
    max_cols = max(1, sw // max(1, w))
    want_cols = 1 if total == 1 else int(math.ceil(math.sqrt(total)))
    cols = max(1, min(want_cols, max_cols))
    rows = int(math.ceil(total / float(cols)))
    cw, ch = max(1, sw // cols), max(1, sh // rows)
    if cw < w or ch < h:
        # 屏幕塞不下网格：级联，避免窗口完全叠在一起
        step = 34
        x = x0 + 24 + (slot % 9) * step
        y = y0 + MENUBAR_H + 16 + (slot % 9) * step
    else:
        col, row = slot % cols, slot // cols
        x = x0 + col * cw + max(0, (cw - w) // 2)
        y = y0 + row * ch + max(0, (ch - h) // 2) + MENUBAR_H
    x = min(max(x, x0), max(x0, x1 - w))
    y = min(max(y, y0 + MENUBAR_H), max(y0 + MENUBAR_H, y1 - h))
    return (x, y)


def resize_window(pid, size, pos=None):
    """设置窗口尺寸（和位置）。需要给控制方授予“辅助功能”权限。"""
    if not pid or not size:
        return False, "no pid"
    w, h = size
    lines = []
    if pos:
        lines.append("set position of window 1 to {%d, %d}" % (int(pos[0]), int(pos[1])))
    lines.append("set size of window 1 to {%d, %d}" % (int(w), int(h)))
    script = ('tell application "System Events" to tell (first process whose unix id is %d)\n' % int(pid)
              + "\n".join(lines) + "\nend tell")
    r = run(["osascript", "-e", script])
    if r.returncode == 0:
        return True, "ok"
    err = (r.stderr or "").strip().splitlines()
    return False, (err[0] if err else "osascript failed")


def do_launch(name, st, place=None, dry=False, fps=None, size=None, extra_flags=None,
              slot=0, total=1, snap=True):
    acct = st["accounts"].get(name)
    if not acct:
        return {"ok": False, "error": T("没有账号 ", "no account: ") + name}
    cookie = kc_get(name)
    if not cookie:
        return {"ok": False, "error": T("账号 %s 没有会话", "account %s has no session") % name}

    flags = dict(acct.get("flags") or {})
    if extra_flags:
        flags.update(extra_flags)

    if dry:
        pos = grid_position(slot, total, size[0], size[1]) if (size and snap) else None
        return {"ok": True, "dry": True, "account": name,
                "bundle_id": bundle_id_for(name),
                "url": build_url("<TICKET>", place),
                "flags": flags, "fps": fps, "size": size, "pos": pos,
                "instance_ready": instance_ready(name)}

    app = ensure_instance(name, flags, fps, quiet=API_MODE)
    injected, inj_msg = inject_cookie(name, cookie)
    ticket, err = mint_ticket(cookie)
    if not ticket:
        return {"ok": False, "error": T("取票失败: %s", "ticket failed: %s") % err}
    url = build_url(ticket, place)
    r = run(["open", "-n", "-a", app, url])
    if r.returncode != 0:
        subprocess.Popen([os.path.join(app, "Contents", "MacOS", "RobloxPlayer"), url],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    pid = clone_pid(app)
    try:
        st.setdefault("accounts", {}).get(name, {})["last_launch"] = {
            "place": place, "at": int(time.time() * 1000), "pid": pid}
        save_state(st)
    except Exception:
        pass
    resized = None
    if size and pid:
        pos = grid_position(slot, total, size[0], size[1]) if snap else None
        ok, msg = resize_window(pid, size, pos)
        resized = {"ok": ok, "detail": msg, "pos": pos}
    return {"ok": True, "account": name, "user_id": acct.get("user_id"),
            "place": place, "pid": pid, "injected": injected, "inject_detail": inj_msg,
            "resized": resized, "url": url}


