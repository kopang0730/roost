def parse_size(s):
    m = re.match(r"^(\d{3,4})[xX](\d{3,4})$", s or "")
    if not m:
        die(T("--size 需要 宽x高，如 1020x640", "--size needs WIDTHxHEIGHT, e.g. 1020x640"))
    return (int(m.group(1)), int(m.group(2)))


def cmd_launch(argv):
    st = load_state()
    if not st["accounts"]:
        die("还没有账号：epmulti accounts add --name main --from-local")
    place, size, fps, dry, names, snap = None, None, None, False, [], True
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--place" and i + 1 < len(argv):
            place = argv[i + 1]
            i += 2
            continue
        if a.startswith("--place="):
            place = a.split("=", 1)[1]
        elif a == "--size" and i + 1 < len(argv):
            size = parse_size(argv[i + 1])
            i += 2
            continue
        elif a.startswith("--size="):
            size = parse_size(a.split("=", 1)[1])
        elif a == "--fps" and i + 1 < len(argv):
            fps = int(argv[i + 1])
            i += 2
            continue
        elif a.startswith("--fps="):
            fps = int(a.split("=", 1)[1])
        elif a == "--no-snap":
            snap = False
        elif a == "--dry-run":
            dry = True
        elif a == "--all":
            names = sorted(st["accounts"])
        else:
            names.append(a)
        i += 1
    if not names:
        names = sorted(st["accounts"])
    bad = [n for n in names if n not in st["accounts"]]
    if bad:
        die("没有这些账号: " + ", ".join(bad))

    rc = 0
    for idx, n in enumerate(names):
        res = do_launch(n, st, place, dry, fps, size,
                        slot=idx, total=len(names), snap=snap)
        if not res.get("ok"):
            say("启动 %s 失败: %s" % (n, res.get("error")), C_RED)
            rc = 1
            continue
        if dry:
            say("[dry-run] %s" % n, C_YEL)
            print("   bundle : " + res["bundle_id"])
            print("   flags  : " + (json.dumps(res["flags"]) if res["flags"] else "-"))
            print("   size   : " + (str(res["size"]) if res["size"] else "-"))
            print("   url    : " + res["url"][:150] + "…")
            continue
        say("启动 %s (u%s) pid=%s %s%s" % (
            n, res.get("user_id"), res.get("pid"),
            "会话已注入" if res.get("injected") else "注入失败: " + str(res.get("inject_detail")),
            "" if not res.get("resized") else
            ("  窗口=" + ("ok" if res["resized"]["ok"] else res["resized"]["detail"]))),
            C_GRN if res.get("injected") else C_YEL)
        time.sleep(0.8)
    sys.exit(rc)


