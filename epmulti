            "instance_ready": instance_ready(n),
        })
    return out


def cmd_api(argv):
    global API_MODE, LOG_STREAM
    API_MODE = True
    LOG_STREAM = sys.stderr
    verb = argv[0] if argv else "state"
    try:
        args = _api_args()
    except Exception as e:
        return emit({"ok": False, "error": T("参数不是合法 JSON: %s", "arguments are not valid JSON: %s") % e})

    try:
        if verb == "state":
            c = local_roblox_cookie()
            try:
                ensure_helper()
                helper = True
            except Exception:
                helper = False
            return emit({"ok": True,
                         "roblox_version": src_version(),
                         "roblox_installed": os.path.isdir(ROBLOX_APP),
                         "local_session": bool(c),
                         "local_session_len": len(c) if c else 0,
                         "clang": run(["clang", "--version"]).returncode == 0,
                         "cookie_writer": helper,
                         "accounts": _accounts_payload()})

        if verb == "local_identity":
            c = local_roblox_cookie()
            if not c:
                return emit({"ok": False, "error": T("本机没有 Roblox 会话", "no local Roblox session")})
            me, err = whoami(c)
            if not me:
                return emit({"ok": False, "error": T("会话无效: %s", "invalid session: %s") % err})
            return emit({"ok": True, "user_id": me["user_id"], "username": me["username"]})

        if verb == "accounts":
            return emit({"ok": True, "accounts": _accounts_payload()})

        if verb == "add_auto":
            cookie = normalize_cookie(args.get("cookie"))
            if not valid_cookie(cookie):
                return emit({"ok": False, "error": T(
                    "没有抓到这个账号的登录态，请重新登录一次",
                    "Could not capture a session — please sign in again")})
            me, err = whoami(cookie)
            if not me:
                return emit({"ok": False, "error": T(
                    "登录态无效（%s），请重新登录" % err,
                    "session is not valid (%s) — please sign in again" % err)})
            st = load_state()
            # 同一个 Roblox 账号重复添加 = 刷新会话
            for existing, a in st["accounts"].items():
                if a.get("user_id") == me["user_id"]:
                    kc_set(existing, cookie)
                    a["username"] = me["username"]
                    a["display_name"] = me["display_name"]
                    save_state(st)
                    return emit({"ok": True, "name": existing, "user_id": me["user_id"],
                                 "username": me["username"], "updated": True})
            base = re.sub(r"[^A-Za-z0-9._-]+", "-", (me["username"] or "").strip()).strip("-").lower()
            base = (base or "account")[:28]
            name, i = base, 2
            while name in st["accounts"]:
                name = "%s-%d" % (base, i)
                i += 1
            kc_set(name, cookie)
            st["accounts"][name] = {"user_id": me["user_id"], "username": me["username"],
                                    "display_name": me["display_name"],
                                    "added_at": int(time.time() * 1000), "flags": {}}
            save_state(st)
            return emit({"ok": True, "name": name, "user_id": me["user_id"],
                         "username": me["username"], "updated": False})

        if verb in ("add", "add_local"):
            name = (args.get("name") or "").strip()
            if not re.match(r"^[A-Za-z0-9._-]{1,32}$", name):
                return emit({"ok": False, "error": T("名字不合法（字母数字 . _ -，<=32）", "invalid name (letters, digits, . _ -, max 32)")})
            cookie = local_roblox_cookie() if verb == "add_local" else normalize_cookie(args.get("cookie"))
            if not valid_cookie(cookie):
                return emit({"ok": False, "error": T("会话串格式不对（应以 _|WARNING:-DO-NOT-SHARE-THIS. 开头）", "malformed session string (must start with _|WARNING:-DO-NOT-SHARE-THIS.)")})
            me, err = whoami(cookie)
            if not me:
                return emit({"ok": False, "error": T("会话无效: %s", "invalid session: %s") % err})
            kc_set(name, cookie)
            st = load_state()
            old = st["accounts"].get(name, {})
            st["accounts"][name] = {"user_id": me["user_id"], "username": me["username"],
                                    "display_name": me["display_name"],
                                    "added_at": old.get("added_at") or int(time.time() * 1000),
                                    "flags": old.get("flags") or {}}
            save_state(st)
            return emit({"ok": True, "name": name, "user_id": me["user_id"],
                         "username": me["username"]})

        if verb == "rename":
            old = (args.get("old") or "").strip()
            new = (args.get("new") or "").strip()
            if not re.match(r"^[A-Za-z0-9._-]{1,32}$", new):
                return emit({"ok": False, "error": T(
                    "新名字不合法（字母数字 . _ -，<=32）",
                    "invalid name (letters, digits, . _ -, max 32)")})
            st = load_state()
            if old not in st["accounts"]:
                return emit({"ok": False, "error": T("没有该账号", "no such account")})
            if new == old:
                return emit({"ok": True, "name": new})
            if new in st["accounts"]:
                return emit({"ok": False, "error": T("名字已被占用", "that name is already taken")})

            acct = st["accounts"].pop(old)
            cookie = kc_get(old)
            if cookie:
                kc_set(new, cookie)
                kc_del(old)

            old_dir, new_dir = instance_dir(old), instance_dir(new)
            if os.path.isdir(old_dir) and not os.path.isdir(new_dir):
                os.rename(old_dir, new_dir)
                app = instance_app(new)
                plist = os.path.join(app, "Contents", "Info.plist")
                run(["/usr/libexec/PlistBuddy", "-c",
                     "Set :CFBundleIdentifier " + bundle_id_for(new), plist])
                run(["/usr/libexec/PlistBuddy", "-c",
                     "Set :CFBundleName Roblox (" + new + ")", plist])
                run(["codesign", "--force", "--deep", "-s", "-", app])
                marker = os.path.join(new_dir, ".epmulti-ready")
                try:
                    m = json.load(open(marker))
                    m["bundle_id"] = bundle_id_for(new)
                    json.dump(m, open(marker, "w"))
                except Exception:
                    pass

            old_jar = os.path.join(BIN, "jar-" + slug(old) + ".app")
            if os.path.isdir(old_jar):
                shutil.rmtree(old_jar, ignore_errors=True)

            src_cookie = os.path.expanduser(
                "~/Library/HTTPStorages/" + bundle_id_for(old) + ".binarycookies")
            dst_cookie = os.path.expanduser(
                "~/Library/HTTPStorages/" + bundle_id_for(new) + ".binarycookies")
            if os.path.exists(src_cookie):
                os.replace(src_cookie, dst_cookie)
                os.chmod(dst_cookie, 0o600)

            st["accounts"][new] = acct
            save_state(st)
            return emit({"ok": True, "name": new})

        if verb == "reveal":
            name = args.get("name")
            d = instance_dir(name)
            target = d if os.path.isdir(d) else BASE
            run(["open", target])
            return emit({"ok": True, "path": target})

        if verb == "rm":
            name = args.get("name")
            st = load_state()
            st["accounts"].pop(name, None)
            save_state(st)
            kc_del(name)
            if name and os.path.exists(instance_dir(name)):
                shutil.rmtree(instance_dir(name))
            return emit({"ok": True})

        if verb == "check":
            name = args.get("name")
            cookie = kc_get(name)
            if not cookie:
                return emit({"ok": False, "error": T("该账号没有会话", "this account has no session")})
            me, err = whoami(cookie)
            if not me:
                return emit({"ok": False, "error": T("会话已失效: %s", "session expired: %s") % err})
            t, err = mint_ticket(cookie)
            if not t:
                return emit({"ok": False, "error": T("取票失败: %s", "ticket failed: %s") % err,
                             "user_id": me["user_id"], "username": me["username"]})
            return emit({"ok": True, "user_id": me["user_id"], "username": me["username"],
                         "ticket_len": len(t)})

        if verb == "flags_get":
            st = load_state()
            a = st["accounts"].get(args.get("name"))
            if not a:
                return emit({"ok": False, "error": T("没有该账号", "no such account")})
            return emit({"ok": True, "flags": a.get("flags") or {}})

        if verb == "flags_set":
            name = args.get("name")
            flags = args.get("flags") or {}
            st = load_state()
            a = st["accounts"].get(name)
            if not a:
                return emit({"ok": False, "error": T("没有该账号", "no such account")})
            a["flags"] = {str(k): str(v) for k, v in flags.items()}
            save_state(st)
            if instance_ready(name):
                app = instance_app(name)
                write_flags(app, a["flags"])
                run(["codesign", "--force", "--deep", "-s", "-", app])
            return emit({"ok": True, "flags": a["flags"]})

        if verb == "launch":
            st = load_state()
            size = args.get("size")
            if isinstance(size, str) and size.strip():
                size = parse_size(size.strip())
            elif not isinstance(size, (list, tuple)):
                size = None
            fps = args.get("fps")
            fps = int(fps) if fps not in (None, "", 0, "0") else None
            res = do_launch(args.get("name"), st, args.get("place") or None,
                            False, fps, size,
                            slot=int(args.get("slot") or 0),
                            total=int(args.get("total") or 1),
                            snap=bool(args.get("snap", True)))
            return emit(res)

        if verb == "launch_all":
            st = load_state()
            size = args.get("size")
            size = parse_size(size.strip()) if isinstance(size, str) and size.strip() else None
            fps = args.get("fps")
            fps = int(fps) if fps not in (None, "", 0, "0") else None
            snap = bool(args.get("snap", True))
            names = sorted(st["accounts"])
            out = []
            for i, nm in enumerate(names):
                out.append(do_launch(nm, st, args.get("place") or None, False, fps, size,
                                     slot=i, total=len(names), snap=snap))
                time.sleep(0.8)
            return emit({"ok": True, "results": out})

        if verb == "presets":
            return emit({"ok": True, "groups": presets_payload(),
                         "perf_preset": FFLAG_PERF_PRESET,
                         "managed_keys": FFLAG_MANAGED_KEYS})

        if verb == "apply_perf":
            name = args.get("name")
            st = load_state()
            a = st["accounts"].get(name)
            if not a:
                return emit({"ok": False, "error": T("没有该账号", "no such account")})
            flags = dict(a.get("flags") or {})
            for k in FFLAG_MANAGED_KEYS:
                flags.pop(k, None)
            flags.update(FFLAG_PERF_PRESET)
            a["flags"] = flags
            save_state(st)
            if instance_ready(name):
                app = instance_app(name)
                write_flags(app, flags)
                run(["codesign", "--force", "--deep", "-s", "-", app])
            return emit({"ok": True, "flags": flags})

        if verb == "reset_flags":
            name = args.get("name")
            st = load_state()
            a = st["accounts"].get(name)
            if not a:
                return emit({"ok": False, "error": T("没有该账号", "no such account")})
            flags = {k: v for k, v in (a.get("flags") or {}).items()
                     if k not in FFLAG_MANAGED_KEYS}
            a["flags"] = flags
            save_state(st)
            if instance_ready(name):
                app = instance_app(name)
                write_flags(app, flags)
                run(["codesign", "--force", "--deep", "-s", "-", app])
            return emit({"ok": True, "flags": flags})

        if verb == "instances":
            st = load_state()
            out = []
            for name, a in sorted(st["accounts"].items()):
                pids = account_pids(name)
                if pids:
                    out.append({"name": name, "pids": pids,
                                "place": (a.get("prefs") or {}).get("place"),
                                "started_at": (a.get("last_launch") or {}).get("at")})
            return emit({"ok": True, "instances": out})

        if verb == "stop":
            name = args.get("name")
            pids = account_pids(name)
            kill_pids(pids)
            return emit({"ok": True, "stopped": pids})

        if verb == "stop_all":
            st = load_state()
            killed = {}
            for name in st["accounts"]:
                pids = account_pids(name)
                if pids:
                    kill_pids(pids)
                    killed[name] = pids
            return emit({"ok": True, "stopped": killed})

        if verb == "set_prefs":
            name = args.get("name")
            st = load_state()
            a = st["accounts"].get(name)
            if not a:
                return emit({"ok": False, "error": T("没有该账号", "no such account")})
            prefs = a.get("prefs") or {}
            for k in ("place", "size", "fps"):
                if k in args:
                    v = args.get(k)
                    if v in (None, "", 0):
                        prefs.pop(k, None)
                    else:
                        prefs[k] = str(v)
            a["prefs"] = prefs
            save_state(st)
            return emit({"ok": True, "prefs": prefs})

        if verb == "version":
            return emit({"ok": True, **roblox_versions()})

        if verb == "place_name":
            key = str(args.get("place") or "").strip()
            if not key.isdigit():
                return emit({"ok": False, "error": T("placeId 不是数字", "placeId is not numeric")})
            st = load_state()
            cache = st.setdefault("place_names", {})
            if key in cache:
                return emit({"ok": True, "name": cache[key], "cached": True})
            try:
                uni = _get_json("https://apis.roblox.com/universes/v1/places/%s/universe" % key)["universeId"]
                data = _get_json("https://games.roblox.com/v1/games?universeIds=%s" % uni)
                nm = data["data"][0]["name"]
                cache[key] = nm
                save_state(st)
                return emit({"ok": True, "name": nm, "cached": False})
            except Exception as e:
                return emit({"ok": False, "error": str(e)[:120]})

        if verb == "open_instances":
            os.makedirs(INSTANCES, exist_ok=True)
            run(["open", INSTANCES])
            return emit({"ok": True, "path": INSTANCES})

        return emit({"ok": False, "error": T("未知 api: ", "unknown api: ") + verb})
    except ApiError as e:
        return emit({"ok": False, "error": str(e)})
    except SystemExit:
        return emit({"ok": False, "error": T("参数解析失败", "argument parsing failed")})
    except Exception as e:
        return emit({"ok": False, "error": "%s: %s" % (type(e).__name__, str(e)[:300])})


