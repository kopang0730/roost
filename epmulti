def _json(handler, obj, code=200):
    body = json.dumps(obj, ensure_ascii=False).encode()
    handler.send_response(code)
    handler.send_header("Content-Type", "application/json; charset=utf-8")
    handler.send_header("Content-Length", str(len(body)))
    handler.end_headers()
    handler.wfile.write(body)


def make_handler(token):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _tok(self, q):
            return q.get("t", [""])[0] == token

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(u.query)
            if u.path == "/":
                if not self._tok(q):
                    self.send_response(403)
                    self.end_headers()
                    self.wfile.write(b"forbidden")
                    return
                body = GUI_HTML.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return
            if u.path == "/api/accounts":
                if not self._tok(q):
                    return _json(self, {"error": "forbidden"}, 403)
                st = load_state()
                accts = [{"name": n, "user_id": a.get("user_id"), "username": a.get("username"),
                          "instance_ready": instance_ready(n),
                          "flags": len(a.get("flags") or {})}
                         for n, a in sorted(st["accounts"].items())]
                return _json(self, {"accounts": accts})
            _json(self, {"error": "not found"}, 404)

        def do_POST(self):
            u = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(u.query)
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except Exception:
                body = {}
            if not self._tok(q):
                return _json(self, {"error": "forbidden"}, 403)
            st = load_state()
            try:
                if u.path == "/api/launch":
                    place = body.get("place") or None
                    size = parse_size(body["size"]) if body.get("size") else None
                    fps = int(body["fps"]) if body.get("fps") else None
                    slot = int(body.get("slot") or 0)
                    total = int(body.get("total") or 1)
                    return _json(self, do_launch(body["name"], st, place, False, fps, size,
                                                 slot=slot, total=total,
                                                 snap=bool(body.get("snap", True))))
                if u.path == "/api/launch_all":
                    place = body.get("place") or None
                    size = parse_size(body["size"]) if body.get("size") else None
                    fps = int(body["fps"]) if body.get("fps") else None
                    out = []
                    names = sorted(st["accounts"])
                    for i, nm in enumerate(names):
                        out.append(do_launch(nm, st, place, False, fps, size,
                                             slot=i, total=len(names),
                                             snap=bool(body.get("snap", True))))
                        time.sleep(0.8)
                    return _json(self, out)
                if u.path == "/api/add":
                    cookie = normalize_cookie(body.get("cookie"))
                    name = (body.get("name") or "").strip()
                    if not re.match(r"^[A-Za-z0-9._-]{1,32}$", name):
                        return _json(self, {"ok": False, "error": "名字不合法"})
                    if not valid_cookie(cookie):
                        return _json(self, {"ok": False, "error": "会话串格式不对"})
                    me, err = whoami(cookie)
                    if not me:
                        return _json(self, {"ok": False, "error": T("会话无效: %s", "invalid session: %s") % err})
                    kc_set(name, cookie)
                    old = st["accounts"].get(name, {})
                    st["accounts"][name] = {"user_id": me["user_id"],
                                            "username": me["username"],
                                            "display_name": me["display_name"],
                                            "added_at": old.get("added_at") or int(time.time() * 1000),
                                            "flags": old.get("flags") or {}}
                    save_state(st)
                    return _json(self, {"ok": True, "user_id": me["user_id"],
                                        "username": me["username"]})
                if u.path == "/api/add_local":
                    cookie = local_roblox_cookie()
                    if not cookie:
                        return _json(self, {"ok": False, "error": T("本机没有 Roblox 会话", "no local Roblox session")})
                    name = (body.get("name") or "main").strip()
                    me, err = whoami(cookie)
                    if not me:
                        return _json(self, {"ok": False, "error": T("会话无效: %s", "invalid session: %s") % err})
                    kc_set(name, cookie)
                    old = st["accounts"].get(name, {})
                    st["accounts"][name] = {"user_id": me["user_id"],
                                            "username": me["username"],
                                            "display_name": me["display_name"],
                                            "added_at": old.get("added_at") or int(time.time() * 1000),
                                            "flags": old.get("flags") or {}}
                    save_state(st)
                    return _json(self, {"ok": True, "user_id": me["user_id"],
                                        "username": me["username"]})
                if u.path == "/api/rm":
                    name = body.get("name")
                    st["accounts"].pop(name, None)
                    save_state(st)
                    kc_del(name)
                    if os.path.exists(instance_dir(name)):
                        shutil.rmtree(instance_dir(name))
                    return _json(self, {"ok": True})
            except SystemExit:
                return _json(self, {"ok": False, "error": T("参数解析失败", "argument parsing failed")})
            except Exception as e:
                return _json(self, {"ok": False, "error": str(e)[:300]})
            _json(self, {"error": "not found"}, 404)

    return H


def cmd_gui(argv):
    token = base64.urlsafe_b64encode(os.urandom(12)).decode().rstrip("=")
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    url = "http://127.0.0.1:%d/?t=%s" % (port, token)
    srv = HTTPServer(("127.0.0.1", port), make_handler(token))
    say("GUI: " + url, C_GRN)
    say("（只监听 127.0.0.1；Ctrl-C 结束）", C_DIM)
    try:
        webbrowser.open(url)
    except Exception:
        pass
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        say("\nbye")


