# ------------------------------------------------------------------ 基础

API_MODE = False
LOG_STREAM = sys.stdout


def say(msg, color=""):
    if API_MODE:
        LOG_STREAM.write((color + msg + C_OFF if color else msg) + "\n")
        LOG_STREAM.flush()
        return
    print((color + msg + C_OFF) if color else msg)


def emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


class ApiError(Exception):
    """API 模式下代替 sys.exit，保证 stdout 只有一行 JSON。"""


def die(msg, code=1):
    say(T("error: ", "error: ") + msg, C_RED)
    if API_MODE:
        raise ApiError(msg)
    sys.exit(code)


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def mask(secret, head=8):
    return (secret[:head] + "…(" + str(len(secret)) + " chars)") if secret else "-"


def slug(name):
    return hashlib.sha1(name.encode()).hexdigest()[:8]


def bundle_id_for(name):
    return "com.roblox.RobloxPlayer.ep" + slug(name)


def load_state():
    if not os.path.exists(STATE):
        return {"accounts": {}}
    with open(STATE) as f:
        st = json.load(f)
    st.setdefault("accounts", {})
    return st


def save_state(st):
    os.makedirs(BASE, exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, sort_keys=True)
    os.replace(tmp, STATE)


# ------------------------------------------------------------------ Keychain

def kc_set(name, secret):
    run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name])
    r = run(["security", "add-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name,
             "-w", secret, "-U"])
    if r.returncode != 0:
        die(T("写入 Keychain 失败: ", "Keychain write failed: ") + (r.stderr or "").strip())


def kc_get(name):
    r = run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name, "-w"])
    return r.stdout.strip() if r.returncode == 0 else None


def kc_del(name):
    run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", name])


