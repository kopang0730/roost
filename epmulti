def local_roblox_cookie():
    """从本机 Roblox 的 CFNetwork cookie 库读 .ROBLOSECURITY。

    binarycookies 的页结构很碎，这里只做“可靠定位”：字符串区按
    domain \\0 name \\0 path \\0 value \\0 排列，找到名字后跳一个路径串，
    再用 Roblox 会话串的固定前缀校验。
    """
    path = os.path.expanduser("~/Library/HTTPStorages/com.roblox.RobloxPlayer.binarycookies")
    if not os.path.exists(path):
        return None
    data = open(path, "rb").read()
    i = data.find(b".ROBLOSECURITY\x00")
    if i < 0:
        return None
    tail = data[i + len(b".ROBLOSECURITY\x00"):]
    for part in tail.split(b"\x00")[:4]:
        if not part:
            continue
        s = part.decode("utf-8", "replace")
        if s.startswith("_|WARNING:-DO-NOT-SHARE-THIS."):
            return s
    return None


def normalize_cookie(raw):
    raw = (raw or "").strip().strip('"')
    if raw.lower().startswith(".robloxsecurity="):
        raw = raw.split("=", 1)[1]
    return raw


def valid_cookie(c):
    return bool(c) and c.startswith("_|WARNING:-DO-NOT-SHARE-THIS.") and len(c) > 100


def read_clipboard():
    r = run(["pbpaste"])
    return r.stdout if r.returncode == 0 else ""


